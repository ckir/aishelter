  "components": {
    "securitySchemes": {
      "AgentSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Agent-Signature",
        "description": "Ed25519 signature over agent_id, timestamp, nonce, method, path and body SHA-256. Companion headers: X-Agent-Id, X-Agent-Timestamp, X-Agent-Nonce."
      }
    },
    "parameters": {
      "AgentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ServiceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "TaskId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "MessageId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Capability": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://aishelter.example/schemas/capability/v1",
        "title": "Agent Capability",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "maxLength": 50
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "invocation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation_id": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      },
      "AgentServiceManifest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://aishelter.example/schemas/agent-service/v1",
        "title": "Agent Service Manifest",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "id",
          "name_for_human",
          "name_for_model",
          "description_for_human",
          "description_for_model",
          "api",
          "capabilities"
        ],
        "properties": {
          "schema_version": {
            "const": "agent-service/v1"
          },
          "id": {
            "type": "string",
            "format": "uri"
          },
          "name_for_human": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name_for_model": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "description_for_human": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "description_for_model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "publisher": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "homepage": {
            "type": "string",
            "format": "uri"
          },
          "logo_url": {
            "type": "string",
            "format": "uri"
          },
          "contact_email": {
            "type": "string",
            "format": "email"
          },
          "legal_info_url": {
            "type": "string",
            "format": "uri"
          },
          "protocols": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "transport": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              ]
            }
          },
          "api": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "url"
            ],
            "properties": {
              "type": {
                "const": "openapi"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "version": {
                "type": "string"
              },
              "openapi_version": {
                "type": "string"
              }
            }
          },
          "authentication": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "none",
                        "bearer",
                        "api_key",
                        "oauth2",
                        "mtls",
                        "signed_request"
                      ]
                    },
                    "scheme": {
                      "type": "string"
                    },
                    "in": {
                      "enum": [
                        "header",
                        "query",
                        "cookie"
                      ]
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              }
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "https://aishelter.example/schemas/capability/v1"
            }
          },
          "when_to_use": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "when_not_to_use": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identity": {
            "type": "object",
            "properties": {
              "algorithm": {
                "const": "Ed25519"
              },
              "request_signing": {
                "type": "boolean"
              },
              "manifest_signing": {
                "type": "boolean"
              }
            }
          },
          "trust": {
            "type": "object",

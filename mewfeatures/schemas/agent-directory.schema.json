{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aishelter.example/schemas/agent-directory/v1",
  "title": "Agent Directory Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "protocols",
    "search",
    "registration"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-directory/v1"
    },
    "id": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search": {
      "type": "object",
      "required": [
        "endpoint"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "semantic": {
          "type": "boolean"
        },
        "reputation": {
          "type": "boolean"
        },
        "pricing": {
          "type": "boolean"
        },
        "protocols": {
          "type": "boolean"
        }
      }
    },
    "registration": {
      "type": "object",
      "required": [
        "endpoint"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "federation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
